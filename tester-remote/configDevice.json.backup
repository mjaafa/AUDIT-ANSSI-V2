                },
                {
                    "command":"df -h | grep -v Filesystem |awk 'NR=3'",
                    "Description": "disk",
                    "dialog":"No",
                    "Store":"info"
                },
                {
                    "command":"ifconfig |grep mtu |cut -d ':' -f1|awk 'NR==18'",
